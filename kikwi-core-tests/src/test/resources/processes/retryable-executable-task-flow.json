{
  "key": "retryable-executable-task-flow",
  "name": "Fluxo Assíncrono de Tarefa Executável com Retry",
  "description": "Fixture de teste: start -> EXECUTABLE_TASK (commitBefore, com RetryPolicy) -> end.",
  "extensionProperties": {},
  "flowNodes": {
    "START_EVENT": {
      "id": "START_EVENT",
      "name": "Start Event",
      "type": "DEFAULT_START_EVENT",
      "commitBefore": false,
      "commitAfter": false,
      "outgoing": [
        { "id": "flow-start-to-task", "name": "", "targetNodeId": "CALCULATE_RISK_TASK", "isDefault": false, "extensionProperties": {} }
      ],
      "extensionProperties": {}
    },
    "CALCULATE_RISK_TASK": {
      "id": "CALCULATE_RISK_TASK",
      "name": "Calcular Risco",
      "type": "EXECUTABLE_TASK",
      "executor": "calculateRisk",
      "commitBefore": true,
      "commitAfter": false,
      "retryPolicy": {
        "strategy": "LINEAR",
        "maxRetries": 2,
        "intervals": ["PT0S", "PT0S"]
      },
      "outgoing": [
        { "id": "flow-task-to-end", "name": "", "targetNodeId": "END_EVENT", "isDefault": false, "extensionProperties": {} }
      ],
      "extensionProperties": {}
    },
    "END_EVENT": {
      "id": "END_EVENT",
      "name": "End Event",
      "type": "DEFAULT_END_EVENT",
      "commitBefore": false,
      "commitAfter": false,
      "outgoing": [],
      "extensionProperties": {}
    }
  },
  "defaultStartPoint": "START_EVENT"
}
