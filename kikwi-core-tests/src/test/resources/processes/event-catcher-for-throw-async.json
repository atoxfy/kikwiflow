{
  "key": "event-catcher-for-throw-async",
  "name": "Espera de Correlacao Completada Por Throw (assincrono)",
  "description": "Fixture de teste: start -> EVENT_CATCHER (commitAfter=true) -> EXECUTABLE_TASK -> end. A continuacao apos a correlacao NAO roda inline: fica persistida como ExecutableTask pendente ate ser retomada.",
  "extensionProperties": {},
  "flowNodes": {
    "START_EVENT": {
      "id": "START_EVENT",
      "name": "Start Event",
      "type": "DEFAULT_START_EVENT",
      "commitBefore": false,
      "commitAfter": false,
      "outgoing": [
        { "id": "flow-start-to-catcher", "name": "", "targetNodeId": "WAIT_ORDER_EVENT", "isDefault": false, "extensionProperties": {} }
      ],
      "extensionProperties": {}
    },
    "WAIT_ORDER_EVENT": {
      "id": "WAIT_ORDER_EVENT",
      "name": "Aguardar Evento do Pedido",
      "type": "EVENT_CATCHER",
      "catchType": "STANDALONE",
      "providerType": "VARIABLE",
      "providerVariable": "orderId",
      "keyPrefix": "ORDER_",
      "keySuffix": "_THROWN",
      "commitBefore": false,
      "commitAfter": true,
      "outgoing": [
        { "id": "flow-catcher-to-after", "name": "", "targetNodeId": "AFTER_CATCH_TASK", "isDefault": false, "extensionProperties": {} }
      ],
      "extensionProperties": {}
    },
    "AFTER_CATCH_TASK": {
      "id": "AFTER_CATCH_TASK",
      "name": "Depois da Correlacao",
      "type": "EXECUTABLE_TASK",
      "executor": "afterCatchHandler",
      "commitBefore": false,
      "commitAfter": false,
      "outgoing": [
        { "id": "flow-after-to-end", "name": "", "targetNodeId": "END_EVENT", "isDefault": false, "extensionProperties": {} }
      ],
      "extensionProperties": {}
    },
    "END_EVENT": {
      "id": "END_EVENT",
      "name": "End Event",
      "type": "DEFAULT_END_EVENT",
      "commitBefore": false,
      "commitAfter": false,
      "outgoing": [],
      "extensionProperties": {}
    }
  },
  "defaultStartPoint": "START_EVENT"
}
