{
  "key": "event-catcher-group-any-timeout-followup",
  "name": "Espera de Correlacao em Grupo (ANY) com Timeout e Continuacao",
  "description": "Fixture de teste: start -> EVENT_CATCHER (GROUP, VARIABLE, ANY) com timer de borda interruptivo -> EXTERNAL_TASK (mantem o processo ativo) -> end. Usada para provar que vencer a corrida ANY limpa o timer de borda sem depender do wipe em bloco de uma instancia concluida.",
  "extensionProperties": {},
  "flowNodes": {
    "START_EVENT": {
      "id": "START_EVENT",
      "name": "Start Event",
      "type": "DEFAULT_START_EVENT",
      "commitBefore": false,
      "commitAfter": false,
      "outgoing": [
        { "id": "flow-start-to-catcher", "name": "", "targetNodeId": "WAIT_FIRST_PROPOSAL", "isDefault": false, "extensionProperties": {} }
      ],
      "extensionProperties": {}
    },
    "WAIT_FIRST_PROPOSAL": {
      "id": "WAIT_FIRST_PROPOSAL",
      "name": "Aguardar Primeira Proposta",
      "type": "EVENT_CATCHER",
      "catchType": "GROUP",
      "providerType": "VARIABLE",
      "providerVariable": "supplierIds",
      "keyPrefix": "SUPPLIER_",
      "keySuffix": "_PROPOSAL",
      "matchPolicy": "ANY",
      "commitBefore": false,
      "commitAfter": false,
      "boundaryEventIds": ["TIMER_SLA_TIMEOUT"],
      "outgoing": [
        { "id": "flow-catcher-to-followup", "name": "", "targetNodeId": "AFTER_PROPOSAL_TASK", "isDefault": false, "extensionProperties": {} }
      ],
      "extensionProperties": {}
    },
    "TIMER_SLA_TIMEOUT": {
      "id": "TIMER_SLA_TIMEOUT",
      "name": "Timeout de SLA",
      "type": "BOUNDARY_INTERRUPTIVE_TIMER",
      "attachedToRef": "WAIT_FIRST_PROPOSAL",
      "providerType": "STATIC",
      "staticValue": "PT24H",
      "commitBefore": false,
      "commitAfter": false,
      "outgoing": [
        { "id": "flow-timeout-to-end", "name": "", "targetNodeId": "END_EVENT_TIMEOUT", "isDefault": false, "extensionProperties": {} }
      ],
      "extensionProperties": {}
    },
    "AFTER_PROPOSAL_TASK": {
      "id": "AFTER_PROPOSAL_TASK",
      "name": "Avaliar Proposta (tarefa externa)",
      "type": "EXTERNAL_TASK",
      "commitBefore": false,
      "commitAfter": false,
      "outgoing": [
        { "id": "flow-followup-to-end", "name": "", "targetNodeId": "END_EVENT_SUCCESS", "isDefault": false, "extensionProperties": {} }
      ],
      "extensionProperties": {}
    },
    "END_EVENT_SUCCESS": {
      "id": "END_EVENT_SUCCESS",
      "name": "Proposta Recebida",
      "type": "DEFAULT_END_EVENT",
      "commitBefore": false,
      "commitAfter": false,
      "outgoing": [],
      "extensionProperties": {}
    },
    "END_EVENT_TIMEOUT": {
      "id": "END_EVENT_TIMEOUT",
      "name": "Cancelado por Timeout",
      "type": "DEFAULT_END_EVENT",
      "commitBefore": false,
      "commitAfter": false,
      "outgoing": [],
      "extensionProperties": {}
    }
  },
  "defaultStartPoint": "START_EVENT"
}
