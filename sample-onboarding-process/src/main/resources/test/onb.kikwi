{
  "key": "onboarding-cliente-bancario-v2",
  "name": "Onboarding de Cliente Bancário com Produtos",
  "version": 2,
  "description": "Onboarding com validações, mesa de análise humana e esteira de ativação de múltiplos produtos via padrão Scatter-Gather.",
  "extensionProperties": {
    "sla.target": "PT48H"
  },
  "defaultStartPoint": "START_EVENT",
  "flowNodes": {
    "START_EVENT": {
      "id": "START_EVENT",
      "name": "Início do Onboarding",
      "type": "DEFAULT_START_EVENT",
      "commitBefore": false,
      "commitAfter": false,
      "outgoing": [
        {"id": "flow-start-parallel", "targetNodeId": "PARALLEL_SPLIT"}
      ],
      "layout": {"x": 100, "y": 300},
      "extensionProperties": {}
    },
    "PARALLEL_SPLIT": {
      "id": "PARALLEL_SPLIT",
      "name": "Divisão de Esteiras",
      "type": "PARALLEL_GATEWAY",
      "commitBefore": false,
      "commitAfter": false,
      "targetJoinId": "JOIN_SYNC",
      "outgoing": [
        {"id": "flow-split-bureau", "targetNodeId": "API_BUREAU"},
        {"id": "flow-split-ui", "targetNodeId": "UI_UPLOAD"}
      ],
      "layout": {"x": 250, "y": 300},
      "extensionProperties": {}
    },
    "API_BUREAU": {
      "id": "API_BUREAU",
      "name": "Consulta Bureau",
      "type": "EXECUTABLE_TASK",
      "executor": "bureauCheckHandler",
      "commitBefore": true,
      "commitAfter": false,
      "retryPolicy": {
        "strategy": "EXPONENTIAL_BACKOFF",
        "maxRetries": 3,
        "initialInterval": "PT10S",
        "multiplier": 2.0,
        "maxInterval": "PT5M"
      },
      "boundaryEventIds": ["ERROR_BUREAU"],
      "outgoing": [
        {"id": "flow-bureau-join", "targetNodeId": "JOIN_SYNC"}
      ],
      "layout": {"x": 400, "y": 200},
      "extensionProperties": {}
    },
    "ERROR_BUREAU": {
      "id": "ERROR_BUREAU",
      "type": "BOUNDARY_ERROR_HANDLER",
      "attachedToRef": "API_BUREAU",
      "errorCode": "BUREAU_UNAVAILABLE",
      "outgoing": [
        {"id": "flow-bureau-error", "targetNodeId": "END_EVENT_ERROR"}
      ],
      "layout": {"x": 450, "y": 260}
    },
    "END_EVENT_ERROR": {
      "id": "END_EVENT_ERROR",
      "name": "Falha Bureau",
      "type": "DEFAULT_END_EVENT",
      "outgoing": [],
      "layout": {"x": 550, "y": 260},
      "extensionProperties": {}
    },
    "UI_UPLOAD": {
      "id": "UI_UPLOAD",
      "name": "Upload Doc & Selfie",
      "type": "EXTERNAL_TASK",
      "commitBefore": false,
      "commitAfter": false,
      "outgoing": [
        {"id": "flow-ui-join", "targetNodeId": "JOIN_SYNC"}
      ],
      "layout": {"x": 400, "y": 400},
      "extensionProperties": {}
    },
    "JOIN_SYNC": {
      "id": "JOIN_SYNC",
      "name": "Sincronização",
      "type": "JOIN_GATEWAY",
      "sourceSplitId": "PARALLEL_SPLIT",
      "commitBefore": false,
      "commitAfter": false,
      "outgoing": [
        {"id": "flow-join-calc", "targetNodeId": "CALC_RISK"}
      ],
      "layout": {"x": 600, "y": 300},
      "extensionProperties": {}
    },
    "CALC_RISK": {
      "id": "CALC_RISK",
      "name": "Calculador Risco",
      "type": "EXECUTABLE_TASK",
      "executor": "motorRiscoHandler",
      "commitBefore": false,
      "commitAfter": false,
      "outgoing": [
        {"id": "flow-calc-decision", "targetNodeId": "DECISION_RISK"}
      ],
      "layout": {"x": 750, "y": 300},
      "extensionProperties": {}
    },
    "DECISION_RISK": {
      "id": "DECISION_RISK",
      "name": "Decisão de Risco",
      "type": "EXCLUSIVE_GATEWAY",
      "providerType": "BEAN",
      "providerBean": "onboardingRiskAnswerProvider",
      "commitBefore": false,
      "commitAfter": false,
      "outgoing": [
        {"id": "flow-approve", "targetNodeId": "CREATE_ACCOUNT", "expectedAnswer": "APPROVED"},
        {"id": "flow-manual-review", "targetNodeId": "MANUAL_DESK", "expectedAnswer": "HIGH_RISK"},
        {"id": "flow-default-review", "targetNodeId": "MANUAL_DESK", "isDefault": true}
      ],
      "layout": {"x": 900, "y": 300},
      "extensionProperties": {}
    },
    "MANUAL_DESK": {
      "id": "MANUAL_DESK",
      "name": "Mesa de Fraude",
      "type": "EXTERNAL_TASK",
      "commitBefore": false,
      "commitAfter": false,
      "boundaryEventIds": ["TIMER_SLA_TIMEOUT"],
      "outgoing": [
        {"id": "flow-desk-decision", "targetNodeId": "DECISION_DESK_RESULT"}
      ],
      "layout": {"x": 1050, "y": 450},
      "extensionProperties": {}
    },
    "DECISION_DESK_RESULT": {
      "id": "DECISION_DESK_RESULT",
      "name": "Resultado da Mesa",
      "type": "EXCLUSIVE_GATEWAY",
      "providerType": "VARIABLE",
      "providerVariable": "resultadoMesa",
      "outgoing": [
        {"id": "flow-desk-approve", "targetNodeId": "CREATE_ACCOUNT", "expectedAnswer": "APPROVED"},
        {"id": "flow-desk-reject", "targetNodeId": "END_EVENT_REJECTED", "isDefault": true}
      ],
      "layout": {"x": 1200, "y": 450}
    },
    "TIMER_SLA_TIMEOUT": {
      "id": "TIMER_SLA_TIMEOUT",
      "type": "BOUNDARY_INTERRUPTIVE_TIMER",
      "attachedToRef": "MANUAL_DESK",
      "providerType": "STATIC",
      "staticValue": "PT24H",
      "outgoing": [
        {"id": "flow-timeout-end", "targetNodeId": "END_EVENT_REJECTED"}
      ],
      "layout": {"x": 1000, "y": 510}
    },
    "END_EVENT_REJECTED": {
      "id": "END_EVENT_REJECTED",
      "name": "Cliente Rejeitado",
      "type": "DEFAULT_END_EVENT",
      "outgoing": [],
      "layout": {"x": 1350, "y": 450},
      "extensionProperties": {}
    },
    "CREATE_ACCOUNT": {
      "id": "CREATE_ACCOUNT",
      "name": "Criação Core Banking",
      "type": "EXECUTABLE_TASK",
      "executor": "criarContaCoreBanking",
      "commitBefore": false,
      "commitAfter": true,
      "retryPolicy": {
        "strategy": "LINEAR",
        "maxRetries": 3,
        "intervals": ["PT1M", "PT5M"]
      },
      "outgoing": [
        {"id": "flow-create-to-products", "targetNodeId": "DISPARAR_PRODUTOS"}
      ],
      "layout": {"x": 1050, "y": 150},
      "extensionProperties": {}
    },
    "DISPARAR_PRODUTOS": {
      "id": "DISPARAR_PRODUTOS",
      "name": "Disparar Produtos (Kafka/API)",
      "type": "EXECUTABLE_TASK",
      "executor": "dispararAtivacaoProdutosHandler",
      "commitBefore": false,
      "commitAfter": false,
      "outgoing": [
        {"id": "flow-products-to-wait", "targetNodeId": "AGUARDAR_PRODUTOS"}
      ],
      "layout": {"x": 1250, "y": 150},
      "extensionProperties": {}
    },
    "AGUARDAR_PRODUTOS": {
      "id": "AGUARDAR_PRODUTOS",
      "name": "Aguardar Efetivação",
      "type": "EXTERNAL_TASK",
      "commitBefore": false,
      "commitAfter": false,
      "boundaryEventIds": ["TIMER_PRODUTOS_TIMEOUT"],
      "outgoing": [
        {"id": "flow-wait-to-success", "targetNodeId": "END_EVENT_SUCCESS"}
      ],
      "layout": {"x": 1450, "y": 150},
      "extensionProperties": {}
    },
    "TIMER_PRODUTOS_TIMEOUT": {
      "id": "TIMER_PRODUTOS_TIMEOUT",
      "type": "BOUNDARY_INTERRUPTIVE_TIMER",
      "attachedToRef": "AGUARDAR_PRODUTOS",
      "providerType": "STATIC",
      "staticValue": "PT48H",
      "outgoing": [
        {"id": "flow-timeout-products", "targetNodeId": "END_EVENT_PARTIAL_SUCCESS"}
      ],
      "layout": {"x": 1400, "y": 210}
    },
    "END_EVENT_SUCCESS": {
      "id": "END_EVENT_SUCCESS",
      "name": "Conta e Produtos Criados",
      "type": "DEFAULT_END_EVENT",
      "outgoing": [],
      "layout": {"x": 1650, "y": 150},
      "extensionProperties": {}
    },
    "END_EVENT_PARTIAL_SUCCESS": {
      "id": "END_EVENT_PARTIAL_SUCCESS",
      "name": "Conta Criada (Produtos com Atraso)",
      "type": "DEFAULT_END_EVENT",
      "outgoing": [],
      "layout": {"x": 1650, "y": 230},
      "extensionProperties": {}
    }
  }
}