{
  "key": "onboarding-ativacao-produtos-paralelo",
  "name": "Ativação de Produtos - Paralelo (CALL_ACTIVITY_COORDINATOR)",
  "version": 1,
  "description": "Demonstra iterationMode PARALLEL (padrão) de CALL_ACTIVITY_COORDINATOR: ativa todos os produtos da lista 'produtos' de uma vez, cada um como uma ProcessInstance filha independente (product-activation-process.kikwi) — mesmo processo filho de onboarding-ativacao-produtos-sequencial.kikwi. Narrativa: notificações/ativações sem dependência de ordem entre si, onde throughput importa mais que sequenciamento. Ver TUTORIAL.md, seção 'CALL_ACTIVITY_COORDINATOR'.",
  "sla": "",
  "extensionProperties": {
    "sla.target": "PT10M"
  },
  "flowNodes": {
    "START_EVENT": {
      "id": "START_EVENT",
      "name": "Início da Ativação Paralela",
      "type": "DEFAULT_START_EVENT",
      "commitBefore": false,
      "commitAfter": false,
      "outgoing": [
        {
          "id": "flow-start-call",
          "name": "",
          "targetNodeId": "CALL_ATIVAR_PRODUTOS",
          "extensionProperties": {}
        }
      ],
      "layout": {
        "x": -58,
        "y": 376
      },
      "extensionProperties": {}
    },
    "CALL_ATIVAR_PRODUTOS": {
      "id": "CALL_ATIVAR_PRODUTOS",
      "name": "Ativar Produtos (todos de uma vez)",
      "type": "CALL_ACTIVITY_COORDINATOR",
      "commitBefore": false,
      "commitAfter": false,
      "calledElement": "product-activation-process",
      "collectionVariable": "produtos",
      "elementVariable": "produto",
      "iterationMode": "PARALLEL",
      "outgoing": [
        {
          "id": "flow-call-after",
          "name": "",
          "targetNodeId": "AFTER_ATIVACAO",
          "extensionProperties": {}
        }
      ],
      "boundaryEventIds": [
        "TIMER_ATIVACAO_TIMEOUT"
      ],
      "layout": {
        "x": 20,
        "y": 364
      },
      "extensionProperties": {}
    },
    "TIMER_ATIVACAO_TIMEOUT": {
      "id": "TIMER_ATIVACAO_TIMEOUT",
      "type": "BOUNDARY_INTERRUPTIVE_TIMER",
      "name": "Timeout da Ativação Paralela",
      "providerType": "STATIC",
      "staticValue": "PT2M",
      "attachedToRef": "CALL_ATIVAR_PRODUTOS",
      "outgoing": [
        {
          "id": "flow-timeout-end",
          "name": "",
          "targetNodeId": "END_EVENT_TIMEOUT",
          "extensionProperties": {}
        }
      ]
    },
    "AFTER_ATIVACAO": {
      "id": "AFTER_ATIVACAO",
      "name": "Depois da Ativação",
      "type": "EXECUTABLE_TASK",
      "executor": "afterProductActivationTaskHandler",
      "commitBefore": false,
      "commitAfter": false,
      "outgoing": [
        {
          "id": "flow-after-end",
          "name": "",
          "targetNodeId": "END_EVENT_SUCCESS",
          "extensionProperties": {}
        }
      ],
      "layout": {
        "x": 360,
        "y": 364
      },
      "extensionProperties": {}
    },
    "END_EVENT_SUCCESS": {
      "id": "END_EVENT_SUCCESS",
      "name": "Todos os Produtos Ativados",
      "type": "DEFAULT_END_EVENT",
      "commitBefore": false,
      "commitAfter": false,
      "outgoing": [],
      "layout": {
        "x": 698,
        "y": 378
      },
      "extensionProperties": {}
    },
    "END_EVENT_TIMEOUT": {
      "id": "END_EVENT_TIMEOUT",
      "name": "Ativação Cancelada por Timeout",
      "type": "DEFAULT_END_EVENT",
      "commitBefore": false,
      "commitAfter": false,
      "outgoing": [],
      "layout": {
        "x": 374,
        "y": 556
      },
      "extensionProperties": {}
    }
  },
  "defaultStartPoint": "START_EVENT"
}